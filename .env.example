# Copy to .env and adjust. All variables are optional.
EDUPULSE_RANDOM_STATE=42
EDUPULSE_TEST_SIZE=0.2
EDUPULSE_CV_FOLDS=5
EDUPULSE_CV_REPEATS=2
EDUPULSE_TUNE=true
EDUPULSE_N_TRIALS=40
EDUPULSE_TUNING_TIMEOUT_S=600
EDUPULSE_TARGET_RECALL=0.80
EDUPULSE_AT_RISK_THRESHOLD=60
EDUPULSE_CONFORMAL_ALPHA=0.10
EDUPULSE_FAIRNESS_ATTRIBUTE=lunch
EDUPULSE_TRACKING=true
EDUPULSE_TRACKING_URI=sqlite:///mlruns/mlflow.db
EDUPULSE_TRACKING_EXPERIMENT=edupulse
EDUPULSE_API_HOST=0.0.0.0
EDUPULSE_API_PORT=8000
EDUPULSE_LOG_LEVEL=INFO
